<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_readonly" model="res.groups">
        <field name="name">PO Lifecycle / Read Only</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">PO Lifecycle / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_po_admin" model="res.groups">
        <field name="name">PO Lifecycle / PO Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="group_superadmin" model="res.groups">
        <field name="name">PO Lifecycle / Super Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_po_admin')), (4, ref('base.group_system'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
