<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_user" model="res.groups">
        <field name="name">Project Lifecycle / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Project Lifecycle / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_finance" model="res.groups">
        <field name="name">Project Lifecycle / Finance</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="group_approver" model="res.groups">
        <field name="name">Project Lifecycle / Approver</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

</odoo>
